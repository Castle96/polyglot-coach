{
  "name": "polyglot-coach",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first AI language tutoring platform",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev:web": "pnpm --filter @polyglot-coach/web dev",
    "dev:desktop": "pnpm --filter @polyglot-coach/desktop dev",
    "build:web": "pnpm --filter @polyglot-coach/web build",
    "build:desktop": "pnpm --filter @polyglot-coach/desktop build",
    "lint": "pnpm -r lint",
    "format": "pnpm -r format",
    "lint:python": "uv run ruff check apps mcp tests tools",
    "format:python": "uv run ruff format apps mcp tests tools",
    "format:python:check": "uv run ruff format --check apps mcp tests tools",
    "typecheck": "uv run mypy apps mcp",
    "test": "uv run pytest",
    "validate": "uv run python tools/validate_curriculum.py --strict"
  },
  "devDependencies": {
    "typescript": "^5.4.0"
  }
}
